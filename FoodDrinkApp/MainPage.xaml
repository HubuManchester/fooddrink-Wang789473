<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.MainPage"
             Title="Smart Recipe Explorer"
             BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#0F172A}">

    <ContentPage.Resources>
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"/>
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="16"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#20000000" Offset="0,4" Radius="12" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        
        <VerticalStackLayout Grid.Row="0" Spacing="0">
           
            <Border Margin="16,16,16,12"
                    StrokeThickness="0"
                    Padding="20"
                    HeightRequest="150">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00695C" Offset="0.0"/>
                        <GradientStop Color="#0097A7" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#00695C80" Offset="0,8" Radius="20" Opacity="0.4"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <Label Text="🍽️ Smart Recipe Explorer"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"/>
                    <Label Grid.Row="1"
                           Text="Explore world cuisines with your phone!"
                           FontSize="13"
                           TextColor="#B2DFDB"/>
                    <HorizontalStackLayout Grid.Row="2" Spacing="12" Margin="0,8,0,0">
                        <Border BackgroundColor="#FFFFFF30"
                                StrokeThickness="0"
                                Padding="10,5"
                                StrokeShape="RoundRectangle 8">
                            <Label Text="🧭 Compass"
                                   TextColor="#FFFFFF"
                                   FontSize="12"
                                   FontAttributes="Bold"/>
                        </Border>
                        <Border BackgroundColor="#FFFFFF30"
                                StrokeThickness="0"
                                Padding="10,5"
                                StrokeShape="RoundRectangle 8">
                            <Label Text="📳 Shake"
                                   TextColor="#FFFFFF"
                                   FontSize="12"
                                   FontAttributes="Bold"/>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- 快速统计 -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="10"
                  Margin="16,0,16,12">
                <Border BackgroundColor="#00695C20" Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="TotalRecipesLabel"
                               Text="0"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#00695C"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Recipes"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#0097A720" Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="CountriesLabel"
                               Text="4"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#0097A7"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Countries"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="#7B1FA220" Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="ExploredLabel"
                               Text="0"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#7B1FA2"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Explored"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 搜索栏 -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  Margin="16,0,16,12">
                <Border Style="{StaticResource ModernCard}"
                        Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="🔍"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="4,0,8,0"/>
                        <SearchBar x:Name="SearchRecipeBar"
                                   Grid.Column="1"
                                   Placeholder="Search recipes..."
                                   TextChanged="OnSearchTextChanged"
                                   SearchButtonPressed="OnSearchButtonPressed"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light=#1F2937, Dark=#F9FAFB}"
                                   PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#9CA3AF}"
                                   SemanticProperties.Hint="Search recipes"/>
                    </Grid>
                </Border>
                <Button Grid.Column="1"
                        Text="🧭"
                        FontSize="20"
                        WidthRequest="50"
                        HeightRequest="50"
                        CornerRadius="12"
                        BackgroundColor="#00695C"
                        TextColor="#FFFFFF"
                        Clicked="OnExploreClicked"
                        SemanticProperties.Hint="Go to hardware exploration"/>
            </Grid>
        </VerticalStackLayout>

        <!-- 菜谱列表 -->
        <RefreshView Grid.Row="1"
                     x:Name="RecipeRefreshView"
                     Refreshing="OnRefreshing"
                     Margin="0,0,0,0">
            <CollectionView x:Name="RecipeCollection"
                            SelectionMode="None"
                            Margin="16,0,16,8">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <Label Text="🍽️" FontSize="64" HorizontalOptions="Center"/>
                        <Label Text="Start Exploring!"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#00695C, Dark=#10B981}"
                               HorizontalOptions="Center"/>
                        <Label Text="Use 🧭 Compass to discover cuisines"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ModernCard}"
                                Margin="0,0,0,12"
                                Padding="0">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- 左侧颜色条 -->
                                <BoxView WidthRequest="6"
                                         BackgroundColor="#00695C"
                                         VerticalOptions="Fill"/>

                                <Grid Grid.Column="1" Padding="16" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <!-- 名称和国旗 -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding CountryEmoji}" FontSize="24"/>
                                        <Label Text="{Binding Name}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#1F2937, Dark=#F9FAFB}"/>
                                    </HorizontalStackLayout>

                                    <!-- 分类标签 -->
                                    <Border Grid.Column="1"
                                            BackgroundColor="#E0F2F1"
                                            StrokeThickness="0"
                                            Padding="8,4"
                                            StrokeShape="RoundRectangle 6">
                                        <Label Text="{Binding Category}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#00695C"/>
                                    </Border>

                                    <!-- 描述 -->
                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Area}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                           Margin="0,6,0,0"/>

                                    <!-- 底部信息 -->
                                    <Grid Grid.Row="2"
                                          Grid.ColumnSpan="2"
                                          ColumnDefinitions="Auto,*"
                                          Margin="0,10,0,0">
                                        <Label Text="{Binding Tags}"
                                               FontSize="12"
                                               TextColor="#0097A7"/>

                                        <Button Grid.Column="1"
                                                Text="View Recipe →"
                                                HorizontalOptions="End"
                                                BackgroundColor="Transparent"
                                                TextColor="#00695C"
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                Padding="8,4"
                                                Clicked="OnViewRecipeClicked"
                                                CommandParameter="{Binding Id}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
