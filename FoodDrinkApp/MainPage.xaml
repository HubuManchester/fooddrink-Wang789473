<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.MainPage"
             Title="Food &amp; Drink"
             SemanticProperties.Description="Food and Drink app with compass menu">

    <ScrollView>
        <VerticalStackLayout 
            Spacing="15"
            Padding="20"
            VerticalOptions="Center">

            <!-- Title -->
            <Label Text="Food &amp; Drink" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   SemanticProperties.Description="App title: Food and Drink"/>

            <!-- Top Buttons Row -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,5">
                <Button Text="🎲 Random"
                        Clicked="OnRandomButtonClicked"
                        BackgroundColor="#E91E63"
                        TextColor="White"
                        CornerRadius="20"
                        HeightRequest="40"
                        WidthRequest="120"
                        SemanticProperties.Hint="Get random recipe"/>

                <Button Text="📋 Menu"
                        Clicked="OnMenuButtonClicked"
                        BackgroundColor="#607D8B"
                        TextColor="White"
                        CornerRadius="20"
                        HeightRequest="40"
                        WidthRequest="120"
                        SemanticProperties.Hint="Menu"/>
            </HorizontalStackLayout>

            <!-- Compass Section -->
            <Frame CornerRadius="20"
                   BackgroundColor="#FFF3E0"
                   Padding="15"
                   SemanticProperties.Description="Compass menu section">
                <VerticalStackLayout>
                    <Label Text="Compass Menu"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           SemanticProperties.Description="Compass menu title"/>

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,*,*"
                          HorizontalOptions="Center"
                          RowSpacing="5"
                          ColumnSpacing="15"
                          Margin="0,10,0,0">

                        <Label Grid.Row="0" Grid.Column="1"
                               Text="N"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Red"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="North direction"/>

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="W"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               SemanticProperties.Description="West direction"/>

                        <Label Grid.Row="1" Grid.Column="1"
                               x:Name="CompassArrow"
                               Text="↑"
                               FontSize="32"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               SemanticProperties.Description="Compass arrow pointing to current direction"/>

                        <Label Grid.Row="1" Grid.Column="2"
                               Text="E"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               SemanticProperties.Description="East direction"/>

                        <Label Grid.Row="2" Grid.Column="1"
                               Text="S"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="South direction"/>
                    </Grid>

                    <Label x:Name="DirectionLabel"
                           Text="Facing: North"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"
                           SemanticProperties.Description="Current facing direction"/>

                    <Label x:Name="CuisineLabel"
                           Text="Current: Chinese"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#FF6B35"
                           Margin="0,5,0,0"
                           SemanticProperties.Description="Current selected cuisine"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Recipe List -->
            <Label Text="Recommended Dishes"
                   FontSize="16"
                   FontAttributes="Bold"
                   SemanticProperties.Description="List of recommended dishes"/>

            <CollectionView x:Name="MealsListView"
                            HeightRequest="350"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="10"
                               BorderColor="#E0E0E0"
                               Padding="10"
                               Margin="0,5">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Tapped="OnMealTapped"
                                    NumberOfTapsRequired="1"/>
                            </Frame.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Image Source="{Binding ImageUrl}"
                                       HeightRequest="60"
                                       WidthRequest="60"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Start"/>
                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       HorizontalOptions="StartAndExpand"
                                       SemanticProperties.Description="{Binding Name}"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Bottom Buttons -->
            <HorizontalStackLayout Spacing="10">
                <Button Text="Shake"
                        Clicked="OnShakeButton"
                        BackgroundColor="#FF9800"
                        TextColor="White"
                        CornerRadius="10"
                        HorizontalOptions="FillAndExpand"
                        SemanticProperties.Hint="Shake your phone to get random recipe"/>

                <Button Text="Speak"
                        Clicked="OnSpeakButton"
                        BackgroundColor="#9C27B0"
                        TextColor="White"
                        CornerRadius="10"
                        HorizontalOptions="FillAndExpand"
                        SemanticProperties.Hint="Read aloud the dish name"/>

                <Button Text="Camera"
                        Clicked="OnCameraButton"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="10"
                        HorizontalOptions="FillAndExpand"
                        SemanticProperties.Hint="Take photo of your food"/>

                <!-- 新增 Location 按钮 -->
                <Button Text="📍 Near Me"
            Clicked="OnLocationButtonClicked"
            BackgroundColor="#2196F3"
            TextColor="White"
            CornerRadius="10"
            HorizontalOptions="FillAndExpand"/>
            </HorizontalStackLayout>

            <!-- Status -->
            <Label x:Name="StatusLabel" 
                   Text="Ready"
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="Application status"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>