<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="食物详情">
    
    <ScrollView x:Name="PageScrollView">
        <ScrollView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Offset="0.0"/>
                <GradientStop Color="{AppThemeBinding Light=#EEF2FF, Dark=#1E293B}" Offset="1.0"/>
            </LinearGradientBrush>
        </ScrollView.Background>

        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- 标题卡片 -->
            <Border StrokeThickness="0" 
                    Padding="24"
                    HeightRequest="180"
                    StrokeShape="RoundRectangle 20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6366F1" Offset="0.0"/>
                        <GradientStop Color="#8B5CF6" Offset="0.5"/>
                        <GradientStop Color="#EC4899" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#6366F160" Offset="0,8" Radius="20" Opacity="0.4"/>
                </Border.Shadow>
                
                <Grid RowDefinitions="*,Auto,Auto" RowSpacing="6">
                    <Label x:Name="CategoryIconLabel"
                           Text="🍽️"
                           FontSize="48"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>
                    <Label x:Name="NameLabel"
                           Grid.Row="1"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"/>
                    <Label x:Name="CategoryLabel"
                           Grid.Row="2"
                           FontSize="16"
                           TextColor="#E0E7FF"/>
                </Grid>
            </Border>

            <!-- 热量大卡片 -->
            <Border StrokeThickness="0"
                    Padding="24"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    StrokeShape="RoundRectangle 16">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,4" Radius="12" Opacity="0.3"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="热量" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
                        <Label x:Name="CaloriesLabel"
                               FontSize="42"
                               FontAttributes="Bold"
                               TextColor="#6366F1"/>
                        <Label Text="千卡"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            BackgroundColor="#6366F120"
                            StrokeThickness="0"
                            WidthRequest="80"
                            HeightRequest="80"
                            StrokeShape="RoundRectangle 40">
                        <Label Text="🔥"
                               FontSize="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 宏量营养素 -->
            <Border StrokeThickness="0"
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    StrokeShape="RoundRectangle 16">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,4" Radius="12" Opacity="0.3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Label Text="🥩 营养成分"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"/>
                    
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border BackgroundColor="#3B82F120" 
                                StrokeThickness="0"
                                Padding="16"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="蛋白质" FontSize="12" TextColor="#3B82F8" HorizontalOptions="Center"/>
                                <Label x:Name="ProteinLabel" Text="0g" FontSize="22" FontAttributes="Bold" TextColor="#3B82F8" HorizontalOptions="Center"/>
                                <ProgressBar x:Name="ProteinProgress"
                                             Progress="0"
                                             ProgressColor="#3B82F8"
                                             HeightRequest="4"
                                             WidthRequest="60"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                BackgroundColor="#10B98120" 
                                StrokeThickness="0"
                                Padding="16"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="碳水" FontSize="12" TextColor="#10B981" HorizontalOptions="Center"/>
                                <Label x:Name="CarbsLabel" Text="0g" FontSize="22" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="Center"/>
                                <ProgressBar x:Name="CarbsProgress"
                                             Progress="0"
                                             ProgressColor="#10B981"
                                             HeightRequest="4"
                                             WidthRequest="60"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2"
                                BackgroundColor="#F59E0B20" 
                                StrokeThickness="0"
                                Padding="16"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="脂肪" FontSize="12" TextColor="#F59E0B" HorizontalOptions="Center"/>
                                <Label x:Name="FatLabel" Text="0g" FontSize="22" FontAttributes="Bold" TextColor="#F59E0B" HorizontalOptions="Center"/>
                                <ProgressBar x:Name="FatProgress"
                                             Progress="0"
                                             ProgressColor="#F59E0B"
                                             HeightRequest="4"
                                             WidthRequest="60"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 描述 -->
            <Border StrokeThickness="0"
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    StrokeShape="RoundRectangle 16">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,4" Radius="12" Opacity="0.3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Label Text="📝 描述"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"/>
                    <Label x:Name="DescriptionLabel"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
                </VerticalStackLayout>
            </Border>

            <!-- 过敏提示 -->
            <Border x:Name="AllergyBorder"
                    StrokeThickness="0"
                    Padding="16"
                    BackgroundColor="#FEF3C7"
                    StrokeShape="RoundRectangle 12">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="⚠️" FontSize="20"/>
                    <Label x:Name="AllergyLabel"
                           FontSize="14"
                           TextColor="#92400E"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <!-- 操作按钮 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="🔊 朗读"
                        BackgroundColor="#6366F1"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="OnSpeakClicked"/>
                <Button Grid.Column="1"
                        Text="⏹ 停止"
                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#334155}"
                        TextColor="{AppThemeBinding Light=#64748B, Dark=#F1F5F9}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="OnStopSpeechClicked"/>
            </Grid>

            <Button Text="📳 震动提醒"
                    BackgroundColor="#10B981"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="OnVibrateClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
