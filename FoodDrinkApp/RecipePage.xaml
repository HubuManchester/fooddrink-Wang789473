<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.RecipePage"
             Title="Recipe Details"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- 菜品图片 -->
            <Frame CornerRadius="20"
                   Padding="10"
                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}">
                <Image x:Name="MealImage"
                       HeightRequest="200"
                       Aspect="AspectFill"
                       HorizontalOptions="Center"/>
            </Frame>

            <!-- 菜品名称 -->
            <Label x:Name="MealName"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- 菜系和类别 -->
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <Label x:Name="MealArea"
                       FontSize="14"
                       TextColor="Gray"/>
                <Label x:Name="MealCategory"
                       FontSize="14"
                       TextColor="Gray"/>
            </HorizontalStackLayout>

            <!-- 分隔线 -->
            <BoxView HeightRequest="1" Color="LightGray"/>

            <!-- 食材标题 -->
            <Label Text="Ingredients"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <!-- 食材列表 -->
            <CollectionView x:Name="IngredientsView"
                            HeightRequest="150">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="10" Margin="0,5">
                            <Label Text="•" FontSize="14" TextColor="#FF6B35"/>
                            <Label Text="{Binding}" FontSize="14"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 制作步骤标题 -->
            <Label Text="Instructions"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <!-- 制作步骤 -->
            <Label x:Name="InstructionsLabel"
                   FontSize="14"/>

            <!-- 语音朗读按钮 -->
            <Button Text="🔊 Read Aloud"
                    Clicked="OnReadAloudClicked"
                    BackgroundColor="#9C27B0"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>